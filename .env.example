# Database Configuration
# PostgreSQL connection string for Prisma (with connection pooling)
DATABASE_URL="postgresql://username:password@host:5432/dbname?pgbouncer=true"

# Direct database connection (without pooling) - used for migrations
DIRECT_URL="postgresql://username:password@host:5432/dbname"

# Authentication
# Secret key for JWT token signing (generate with: openssl rand -base64 32)
JWT_SECRET="your-secret-key-here"
JWT_EXPIRATION="7d"

# NextAuth.js configuration
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# External APIs
# Booking API Configuration
BOOKING_API_URL="https://booking-api.example.com"
BOOKING_API_KEY="your-booking-api-key-here"

# French Government API Configuration
GOVERNMENT_API_URL="https://government-api.example.fr"
GOVERNMENT_API_KEY="your-government-api-key-here"

# Vercel Services
# Blob Storage for file uploads (homework submissions)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxx"

# Cron Job Authentication
# Secret token to protect cron endpoints (generate with: openssl rand -hex 32)
CRON_SECRET="your-cron-secret-here"

# Email Configuration (SMTP)
# For development, consider using Mailtrap (https://mailtrap.io) or Ethereal (https://ethereal.email)
# Production: Use a service like SendGrid, Mailgun, or AWS SES
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false" # Set to "true" for port 465, "false" for other ports
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="noreply@yourplatform.com"

# Application Configuration
# Set to 'production' in production environment
NODE_ENV="development"

# Base URL for the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feature Flags (optional)
NEXT_PUBLIC_ENABLE_NOTIFICATIONS="true"
NEXT_PUBLIC_MAX_FILE_SIZE_MB="10"
